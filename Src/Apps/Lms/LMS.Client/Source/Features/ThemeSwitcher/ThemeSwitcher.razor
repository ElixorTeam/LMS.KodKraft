@using Blazor.Heroicons.Outline

<Button
  id="theme-button"
  Kind="@BtnKind.Ghost"
  Size="@BtnSize.Icon"
  OnClick="@ToggleTheme"
>
  <SunIcon class="size-5 dark:hidden"/>
  <MoonIcon class="size-5 hidden dark:block"/>
</Button>

@code {
  [Inject] private IJSRuntime JsRuntime { get; set; } = null!;

  private async Task ToggleTheme() => await JsRuntime.InvokeVoidAsync("toggleTheme");
}