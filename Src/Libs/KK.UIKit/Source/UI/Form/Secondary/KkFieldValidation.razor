@namespace KK.UIKit.UI
@using System.Linq.Expressions

@typeparam TValue
@inherits KkComponentBase

<ValidationMessage For="@For" class="@ClassMerge("text-sm font-medium text-destructive", Class)" />

@code {
  /// <summary>
  /// The expression representing the field or property to validate.
  /// </summary>
  [Parameter] public Expression<Func<TValue>>? For { get; set; }
}
