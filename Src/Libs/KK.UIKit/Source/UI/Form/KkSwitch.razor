@namespace KK.UIKit.UI
@inherits KK.UIKit.UI.Internal.InputBase<bool>

<FluentSwitch
  AdditionalAttributes="@AdditionalAttributes"
  Id="@Id"
  @bind-Value="Value"
  @bind-Value:after="OnValueChanged"
  Class="@Css.Class("[&::part(switch)]:border-transparent", Class)"
  Autofocus="AutoFocus"
  ReadOnly="ReadOnly"
  Disabled="Disabled"
/>