@namespace KK.UIKit.UI.Internal
@typeparam TSelectItem
@typeparam TSelectType where TSelectType : TSelectItem
@attribute [CascadingTypeParameter(nameof(TSelectItem))]
@attribute [CascadingTypeParameter(nameof(TSelectType))]
@inherits SelectBase<TSelectItem, TSelectType>

<CascadingValue Value="this">
  @ChildContent
</CascadingValue>

@code {
  /// <summary>
  /// The content to be rendered inside the component.
  /// </summary>
  [Parameter] public RenderFragment? ChildContent { get; set; }

  internal protected override async Task SetValue(TSelectItem item, bool withClose = true)
  {
    if (item is TSelectType or null)
    {
      Value = (TSelectType?) item;
      await TriggerValueChanged();
      if (!withClose) return;
      IsDropdownOpened = false;
      Reset();
    }
  }

  internal protected override bool IsItemSelected(TSelectItem item) => (Value == null && item == null) || (Value != null && Value.Equals(item));
}