@using LMS.Components.Source.Utils
@using Microsoft.FluentUI.AspNetCore.Components
@inherits InputBase<bool>

<FluentCheckbox
  AdditionalAttributes="AdditionalAttributes"
  @bind-Value="Value"
  @bind-Value:after="OnValueChanged"
  Class="@Css.Class("[&::part(control)]:!border-transparent", Class)"
  Label="@Label"
  Autofocus="@AutoFocus"
  Disabled="Disabled"
  ReadOnly="ReadOnly"
/>

@code {
  /// <summary>
  /// The text label displayed.
  /// </summary>
  [Parameter] public string? Label { get; set; }
}
