@inherits InputBase<string>
@namespace LMS.Components.UI

<input
  @attributes="AdditionalAttributes"
  id="@Id"
  type="@Type.GetDescription()"
  @bind="Value"
  @bind:after="OnValueChanged"
  class="@ClassMerge(BaseClass, Tw.FocusVisible, Class)"
  disabled="@Disabled"
  readonly="@ReadOnly"
  autofocus="@AutoFocus"
  placeholder="@Placeholder"
/>

@code {
  [Parameter] public TextInputType Type { get; set; } = TextInputType.Text;

  const string BaseClass =
    // Placeholder, selection, theme
    "placeholder:text-muted-foreground selection:bg-primary selection:text-primary-foreground dark:bg-input/30 " +
    // Border, background, shape, size
    "border-input border rounded-md h-9 w-full min-w-0 bg-transparent px-3 py-1 " +
    // Typography
    "text-base md:text-sm " +
    // Shadow, transition, outline
    "shadow-xs transition-[color,box-shadow] outline-none " +
    // Disabled state
    "disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50";
}