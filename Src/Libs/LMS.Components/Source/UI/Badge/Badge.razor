@inherits LmsComponentBase

<div
  @attributes="AdditionalAttributes"
  id="@Id"
  class="@ClassMerge(BaseClasses, KindClasses, Class)"
>
  @ChildContent
</div>

@code {
  /// <summary>
  /// The content to be rendered inside the component.
  /// </summary>
  [Parameter] public RenderFragment? ChildContent { get; set; }

  /// <summary>
  /// Defines the visual style of the badge.
  /// </summary>
  [Parameter] public BadgeKind Kind { get; set; } = BadgeKind.Default;

  private static string BaseClasses => "inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 select-none";

  private string KindClasses => Kind switch
  {
    BadgeKind.Default => "bg-primary text-primary-foreground [a&]:hover:bg-primary/90",
    BadgeKind.Secondary => "bg-secondary text-secondary-foreground [a&]:hover:bg-secondary/90",
    BadgeKind.Destructive => "bg-destructive text-white [a&]:hover:bg-destructive/90 focus-visible:ring-destructive/20 dark:focus-visible:ring-destructive/40 dark:bg-destructive/60",
    BadgeKind.Outline => "border text-foreground [a&]:hover:bg-accent [a&]:hover:text-accent-foreground",
    _ => string.Empty
  };
}
