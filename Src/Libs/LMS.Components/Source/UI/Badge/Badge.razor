@inherits LmsComponentBase

<div
  @attributes="AdditionalAttributes"
  id="@Id"
  class="@ClassMerge(BaseClasses, KindClasses, Class)"
>
  @ChildContent
</div>

@code {
  /// <summary>
  /// The content to be rendered inside the component.
  /// </summary>
  [Parameter] public RenderFragment? ChildContent { get; set; }

  /// <summary>
  /// Defines the visual style of the badge.
  /// </summary>
  [Parameter] public BadgeKind Kind { get; set; } = BadgeKind.Default;

  private static string BaseClasses => "inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 select-none";

  private string KindClasses => Kind switch
  {
    BadgeKind.Default => KindCssFromColor("primary"),
    BadgeKind.Secondary => KindCssFromColor("secondary"),
    BadgeKind.Destructive => KindCssFromColor("destructive"),
    BadgeKind.Outline => "text-foreground",
    _ => string.Empty
  };

  private static string KindCssFromColor(string color) =>
    $"border-transparent bg-{color} text-{color}-foreground hover:bg-{color}/80";
}
