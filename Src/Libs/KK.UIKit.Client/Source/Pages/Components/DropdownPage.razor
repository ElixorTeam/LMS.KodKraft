@attribute [Route($"{Urls.Dropdown}")]
@using Blazor.Heroicons.Outline
@using KK.UIKit.Client.Source.Shared.Constants
@using KK.UIKit.Client.Source.Shared.UI.View
@using Microsoft.FluentUI.AspNetCore.Components

<ViewHeader Title="Dropdown" />

<div class="max-w-4xl mx-auto space-y-12">
  <section class="space-y-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
      <KkButton
        id="theme-button"
        Variant="BtnVariant.Ghost"
        Size="BtnSize.Icon"
        OnClick="@(() => IsOpen = !IsOpen)"
        Class="shrink-0"
      >
        <SunIcon class="size-5 dark:hidden" />
        <MoonIcon class="size-5 hidden dark:block" />
        <span class="sr-only">Toggle theme</span>
      </KkButton>

      <KkDropdown
        Anchor="theme-button"
        @bind-Visible="@IsOpen"
        VerticalThreshold="300"
        Position="@VerticalPosition.Bottom">
        <ul class="flex flex-col p-1">
          <li>
            <KkDropdownItem OnClick="@(() => SetTheme("light"))">
              <SunIcon class="size-4 mr-2"/>
              <span>Светлая тема</span>
            </KkDropdownItem>
          </li>
          <li>
            <KkDropdownItem OnClick="@(() => SetTheme("dark"))">
              <MoonIcon class="size-4 mr-2"/>
              <span>Темная тема</span>
            </KkDropdownItem>
          </li>
          <li>
            <KkDropdownItem OnClick="@(() => SetTheme("system"))">
              <ComputerDesktopIcon class="size-4 mr-2"/>
              <span>Система</span>
            </KkDropdownItem>
          </li>
        </ul>
      </KkDropdown>
    </div>
  </section>
</div>

@code {
  [Inject] private IJSRuntime JsRuntime { get; set; } = null!;

  private bool IsOpen { get; set; }

  private async Task SetTheme(string theme)
  {
    await JsRuntime.InvokeVoidAsync("switchTheme", theme);
    IsOpen = false;
  }
}