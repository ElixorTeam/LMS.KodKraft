@using LMS.Components.Client.Source.Shared.UI.View
@using LMS.Components.Source.UI.Form
@attribute [Route($"{Urls.Bool}")]

<ViewHeader Title="Boolean Fields" />


<div class="max-w-4xl mx-auto space-y-10">

  <section class="space-y-4">
    <h2 class="text-xl font-semibold">@nameof(Switch)</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="space-y-1">
        <p class="text-sm text-muted-foreground">Default</p>
        <Switch @bind-Value="@_switchValue"/>
      </div>

      <div class="space-y-1">
        <p class="text-sm text-muted-foreground">ReadOnly</p>
        <Switch Value="@false" ReadOnly />
        <Switch Value="@true" ReadOnly />
      </div>

      <div class="space-y-1">
        <p class="text-sm text-muted-foreground">Disabled</p>
        <Switch Value="@false" Disabled />
        <Switch Value="@true" Disabled />
      </div>
    </div>
  </section>

  <div class="max-w-4xl mx-auto space-y-10">
    <section class="space-y-4">
      <h2 class="text-xl font-semibold">@nameof(InputCheckboxField)</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="space-y-1">
          <p class="text-sm text-muted-foreground">Default</p>
          <InputCheckboxField @bind-Value="@_switchValue" />
        </div>

        <div class="space-y-1">
          <p class="text-sm text-muted-foreground">ReadOnly</p>
          <InputCheckboxField Value="@false" ReadOnly />
          <InputCheckboxField Value="@true" ReadOnly />
        </div>

        <div class="space-y-1">
          <p class="text-sm text-muted-foreground">Disabled</p>
          <InputCheckboxField Value="@false" Disabled />
          <InputCheckboxField Value="@true" Disabled />
        </div>
      </div>
    </section>
  </div>

</div>

@code {
  bool _switchValue;
}