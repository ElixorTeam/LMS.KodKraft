@using LMS.Components.Client.Source.Shared.UI.View
@using LMS.Components.Source.UI.Button
@attribute [Route($"{Urls.Button}")]

<ViewHeader Title="Button" />

<div class="max-w-4xl mx-auto space-y-12">

  <section class="space-y-4">
    <h2 class="text-xl font-semibold">Variants</h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
      @foreach (BtnKind variant in Enum.GetValues<BtnKind>())
      {
        <div class="border rounded-lg p-4 flex flex-col gap-3">
          <div class="flex gap-2">
            <Button Kind="variant" class="flex-1">@variant.GetDescription()</Button>
            <Button Kind="variant" Disabled class="flex-1">Disabled</Button>
          </div>
        </div>
      }
    </div>
  </section>

  <section class="space-y-4 w-full px-4">
    <h2 class="text-xl font-semibold">Sizes</h2>
    <div class="flex w-full justify-start gap-2">
      @foreach (BtnSize size in Enum.GetValues<BtnSize>())
      {
        <Button Size="size">@size.GetDescription()</Button>
      }
    </div>
  </section>
</div>