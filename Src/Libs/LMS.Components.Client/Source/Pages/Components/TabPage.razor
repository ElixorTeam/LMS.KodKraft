@using LMS.Components.Client.Source.Shared.UI.View
@using LMS.Components.Source.Helper
@using LMS.Components.Source.UI.Badge
@using LMS.Components.Source.UI.Tabs
@using LMS.Components.Source.UI.Button
@attribute [Route($"{Urls.Tab}")]

<ViewHeader Title="Tab" />

<div class="flex gap-2 mb-4">
  @foreach (string tab in _tabs)
  {
    <Button Kind="BtnKind.Link"
            Disabled="@(CurrentTab == tab)"
            OnClick="@(() => LinkTab(tab))">
      @tab.Capitalize()
    </Button>
  }
</div>

<div class="mt-4 flex items-center gap-2">
  <Badge Kind="BadgeKind.Default">Current tab:</Badge>
  <span class="font-semibold text-gray-700 text-sm">
    @CurrentTab.Capitalize()
  </span>
</div>

<div class="flex items-center gap-2 mt-2">
  <Badge Kind="BadgeKind.Destructive">Current URL:</Badge>
  <span class="font-mono text-gray-700 text-xs break-all">
    @NavigationManager.Uri
  </span>
</div>

<Tabs @bind-ActiveTabId="@CurrentTab">
  @foreach (string tab in _tabs)
  {
    <Tab Id="@tab">
      <div class="mt-2 rounded-lg shadow-sm  border text-gray-700 text-sm leading-relaxed">
        This is the <span class="font-medium">@tab</span> content section.
      </div>
    </Tab>
  }
</Tabs>

@code {
  [Inject] private PageHelper PageHelper { get; set; } = null!;
  [Inject] private NavigationManager NavigationManager { get; set; } = null!;

  private string CurrentTab { get; set; } = string.Empty;

  private readonly List<string> _tabs = ["info", "test", "data", "label"];

  protected override void OnInitialized()
  {
    CurrentTab = PageHelper.GetUrlQueryParam("tab") ?? "info";
  }

  private void LinkTab(string tabId)
  {
    CurrentTab = tabId;
    string uri = NavigationManager.GetUriWithQueryParameter("tab", CurrentTab);
    NavigationManager.NavigateTo(uri, false, true);
  }
}