@using LMS.Components.Client.Source.Shared.UI.View
@attribute [Route($"{Urls.Badge}")]

<ViewHeader Title="Badge" />

<h1>Variants</h1>
<div class="flex gap-1 mt-2 ">
  @foreach (BadgeKind variant in Enum.GetValues<BadgeKind>())
  {
    <Badge Kind="variant">@variant.GetDescription()</Badge>
  }
</div>